# Image built by GitHub Actions from your repository (lower-case owner/repo).
DASH_IMAGE=ghcr.io/OWNER/homelab-dashboard:latest
# Public hostname served by Traefik.
DASH_HOST=dashbard.safrani.co
# Name of the certificate resolver in your Traefik static config (traefik.yml → certificatesResolvers).
CERT_RESOLVER=cloudflare
TZ=Asia/Riyadh
DASH_COLLECTOR_LABEL=dashboard container on Arr-Stack
